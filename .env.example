GEMINI_API_KEY=your_gemini_api_key_here
DATABASE_URL=your_postgresql_database_url

# Razorpay (Kept for reference/legacy, but not used for active payments)
NEXT_PUBLIC_RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Cashfree (Active Payment Gateway)
NEXT_PUBLIC_CASHFREE_APP_ID=your_cashfree_app_id
CASHFREE_SECRET_KEY=your_cashfree_secret_key
CASHFREE_ENVIRONMENT=PRODUCTION

CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_URL=your_cloudinary_url

Brevo_api_key=your_brevo_api_key
admin_mails=admin1@example.com, admin2@example.com
Fast2SMS_API_KEY=your_fast2sms_api_key

# Application URL (used for Cashfree return URLs and absolute app links)
NEXT_PUBLIC_APP_URL=https://doctivo.in

# Authentication & Session Security (JWT Secrets)
JWT_SECRET=your_jwt_access_secret_key_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here